--- Essential KPIs to Track

SELECT 
SUM(SALES) AS REVENUE,
COUNT(DISTINCT Order_ID) AS TOTAL_ORDERS,
COUNT(DISTINCT Customer_ID)	 AS TOTAL_CUSTOMERS,
SUM(SALES) / COUNT(DISTINCT Order_ID)  AS AOI,
AVG(Shipping_Duration) AS AVG_SHIPPING_DURATION
FROM SUPERSTORE_DATA;

---- MONTH OVER MONTH GROWTH RATE 
SELECT 
ORDER_YEAR,
ORDER_MONTH,
REVENUE,
LAG(REVENUE) OVER(ORDER BY ORDER_YEAR, ORDER_MONTH) AS PREV_REVENUE,
    ROUND(
        ((REVENUE - LAG(REVENUE) OVER(ORDER BY ORDER_YEAR, ORDER_MONTH)) 
         / LAG(REVENUE) OVER(ORDER BY ORDER_YEAR, ORDER_MONTH)) * 100, 
        2
    ) AS MOM_PERCENT_CHANGE
FROM(
SELECT
        YEAR(Order_Date) AS ORDER_YEAR,
        MONTH(Order_Date) AS ORDER_MONTH,
        SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY YEAR(Order_Date), MONTH(Order_Date)
) AS t



--- Which months generate peak seasonal revenue?
WITH PEAK_MONTHLY_SALE AS (
SELECT 
DATEPART(YEAR, Order_Date) AS ORDER_YEAR,
DATEPART(MONTH, Order_Date) AS ORDER_MONTH,
SUM(SALES) AS MONTHLY_REVENUE,
MAX(SUM(SALES)) OVER(PARTITION BY DATEPART(YEAR, Order_Date)) AS MAXIMUM_REVENUE
FROM SUPERSTORE_DATA
GROUP BY DATEPART(YEAR, Order_Date), DATEPART(MONTH, Order_Date) 
)
SELECT
ORDER_YEAR,
ORDER_MONTH,
MAXIMUM_REVENUE
FROM PEAK_MONTHLY_SALE
WHERE MONTHLY_REVENUE = MAXIMUM_REVENUE
ORDER BY ORDER_YEAR, ORDER_MONTH;

--- Which QUARTER generate peak seasonal revenue?
WITH PEAK_QUARTER_SALES AS(
SELECT
YEAR(Order_Date) AS YEAR,
DATEPART(QUARTER, Order_Date) AS QUARTER, 
MAX(SUM(SALES)) OVER(PARTITION BY YEAR(Order_Date)) AS MAXIMUM_REVENUE,
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY DATEPART(QUARTER, Order_Date), YEAR(Order_Date)
)
SELECT 
YEAR,
QUARTER, 
MAXIMUM_REVENUE
FROM PEAK_QUARTER_SALES
WHERE MAXIMUM_REVENUE = REVENUE


---- What is the Average Order Value (AOV) across different customer segments?
SELECT
Customer_ID, 
COUNT(Order_ID) AS TOTAL_ORDER, 
SUM(SALES) AS REVENUE ,
CASE 
WHEN COUNT(Order_ID) = 0 THEN 0
ELSE ROUND(SUM(SALES)/COUNT(Order_ID), 2)
END  AS AOV 
FROM SUPERSTORE_DATA
GROUP BY Customer_ID
ORDER BY AOV DESC

--- Which Product Categories and Sub-Categories drive the highest revenue share?
SELECT --- Categories
Category, 
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Category
ORDER BY SUM(SALES) DESC

SELECT   --- TOP 10 SUB CATEGORY AS HIGHEST REVENUE
Sub_Category,  --- Sub-Categories
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Sub_Category
ORDER BY SUM(SALES) DESC

---What are the Top 10 best-selling products vs. Bottom 10 underperforming products?
SELECT TOP 10 --- TOP 10 BEST-SELLING PRODUCTS
Product_ID,
Product_Name,  --- Sub-Categories
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Product_ID,Product_Name
ORDER BY SUM(SALES) DESC

SELECT TOP 10 --- TOP 10 UNDERPERFORMING PRODUCTS 
Product_ID,
Product_Name, 
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Product_ID,Product_Name
ORDER BY SUM(SALES) ASC

-- Which sub-categories sell high volumes but generate low dollar revenue?
WITH SUB_CATEGORIES AS (
SELECT  
Sub_Category,  
COUNT(Sub_Category) AS TOTAL_COUNT,
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Sub_Category
)
SELECT 
*
FROM SUB_CATEGORIES
WHERE TOTAL_COUNT > (SELECT AVG(TOTAL_COUNT) FROM SUB_CATEGORIES)
AND REVENUE < (SELECT AVG(REVENUE) FROM SUB_CATEGORIES);

---Which Regions, States, and Cities generate the most sales revenue?
WITH REGION_SALES AS (
    SELECT 
        Region, 
        SUM(SALES) AS TOTAL_REVENUE
    FROM SUPERSTORE_DATA
    GROUP BY Region
),STATE_SALES AS (
    SELECT 
        STATE, 
        SUM(SALES) AS TOTAL_REVENUE
    FROM SUPERSTORE_DATA
    GROUP BY STATE
),CITY_SALES AS (
    SELECT 
        City, 
        SUM(SALES) AS TOTAL_REVENUE
    FROM SUPERSTORE_DATA
    GROUP BY City
    )
SELECT 'Region' AS LEVEL, Region AS NAME, TOTAL_REVENUE
FROM REGION_SALES
WHERE TOTAL_REVENUE = (SELECT MAX(TOTAL_REVENUE) FROM REGION_SALES)
UNION ALL
SELECT 'State' AS LEVEL, STATE AS NAME, TOTAL_REVENUE 
FROM STATE_SALES
WHERE TOTAL_REVENUE = (SELECT MAX(TOTAL_REVENUE) FROM STATE_SALES)
UNION ALL
SELECT 'City' AS LEVEL, City AS NAME, TOTAL_REVENUE 
FROM CITY_SALES
WHERE TOTAL_REVENUE = (SELECT MAX(TOTAL_REVENUE) FROM CITY_SALES);

-- How does sales revenue distribute across customer segments (Consumer, Corporate, Home Office)?
SELECT 
Segment,
SUM(Sales) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Segment;

---- Are specific product categories dominating specific regions?
WITH Product_Category_dominating AS (
SELECT 
Region,
Category,
COUNT(Category) AS Category_Count,
MAX(COUNT(Category)) OVER(PARTITION BY Region) AS MAXIMUM_COUNT
FROM SUPERSTORE_DATA
GROUP BY Region,Category
)
SELECT 
Region,
Category,
MAXIMUM_COUNT
FROM Product_Category_dominating
WHERE  Category_Count = MAXIMUM_COUNT

---What is the distribution of orders across different Ship Modes (Standard Class, Second Class, First Class, Same Day)?
SELECT Ship_Mode,
COUNT(Order_ID) AS TOTAL_ORDER_COUNT,
SUM(SALES) AS TOTAL_SALES
FROM SUPERSTORE_DATA
GROUP BY  Ship_Mode;

--Does fulfillment speed (Shipping Duration) vary by region or order size?
WITH SHIPPING_DUR_VARY AS(
SELECT 
Shipping_Duration,
REGION,
COUNT(Order_ID) AS TOTAL_ORDER,
SUM(SALES) AS REVENUE
FROM SUPERSTORE_DATA
GROUP BY Shipping_Duration, REGION
)
SELECT*,
AVG(REVENUE) OVER(PARTITION BY Shipping_Duration) AS AVG_REVENUE,
AVG(TOTAL_ORDER) OVER(PARTITION BY Shipping_Duration) AS AVG_ORDER
FROM SHIPPING_DUR_VARY;

--Running cumulative totals sales 
WITH CUSTOMER_SALES AS (
    SELECT 
        Customer_ID,
        SUM(SALES) AS TOTAL_SALES
    FROM SUPERSTORE_DATA
    GROUP BY Customer_ID
)
SELECT 
    Customer_ID,
    TOTAL_SALES,
    SUM(TOTAL_SALES) OVER (ORDER BY TOTAL_SALES DESC) AS Running_Total,
    SUM(TOTAL_SALES) OVER () AS Grand_Total,
    ROUND(
        SUM(TOTAL_SALES) OVER (ORDER BY TOTAL_SALES DESC) * 100.0 
        / SUM(TOTAL_SALES) OVER (), 2
    ) AS Cumulative_Percent
FROM CUSTOMER_SALES
ORDER BY TOTAL_SALES DESC;

--- month over month analysis
SELECT(
ORDER_YEAR,
ORDER_MONTH,
MAXIMUM_REVENUE
FROM (SELECT 
DATEPART(YEAR, Order_Date) AS ORDER_YEAR,
DATEPART(MONTH, Order_Date) AS ORDER_MONTH,
SUM(SALES) AS MONTHLY_REVENUE,
MAX(SUM(SALES)) OVER(PARTITION BY DATEPART(YEAR, Order_Date)) AS MAXIMUM_REVENUE
FROM SUPERSTORE_DATA
GROUP BY DATEPART(YEAR, Order_Date), DATEPART(MONTH, Order_Date) 
)t
WHERE MONTHLY_REVENUE = MAXIMUM_REVENUE
ORDER BY ORDER_YEAR, ORDER_MONTH;
